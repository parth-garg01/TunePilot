# Copy this file to .env and fill in your credentials.
# Do NOT commit .env or credentials/ to source control.

# Kaggle credentials (see: https://www.kaggle.com/settings)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Hugging Face (optional, for private repos or higher rate limits)
HF_TOKEN=

# Orchestrator settings
ORCHESTRATOR_HOME=./projects
ORCHESTRATOR_LOG_LEVEL=INFO
ORCHESTRATOR_DB_PATH=./projects/orchestrator.sqlite
